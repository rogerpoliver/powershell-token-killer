#!/usr/bin/env sh
# Commit-msg hook: validate conventional commit format (pure shell, no npm needed)
set -e

MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"

# Strip comments and leading/trailing whitespace
SUBJECT="$(echo "$MSG" | grep -v '^#' | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

if [ -z "$SUBJECT" ]; then
    echo "[ptk] commit message is empty"
    exit 1
fi

# Pattern: type(scope)!: subject  OR  type!: subject  OR  type: subject
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
PATTERN="^($TYPES)(\([a-z0-9/._-]+\))?(!)?: .+"

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
    echo ""
    echo "[ptk] invalid commit message: $SUBJECT"
    echo "      format: <type>(<scope>): <subject>"
    echo "      types:  feat fix docs style refactor perf test build ci chore revert"
    echo "      example: feat(ps): add get-eventlog filter"
    exit 1
fi

# Subject (after the colon) must start with lower-case
AFTER_COLON="$(echo "$SUBJECT" | sed 's/^[^:]*: //')"
FIRST_CHAR="$(echo "$AFTER_COLON" | cut -c1)"

if echo "$FIRST_CHAR" | grep -qE "[A-Z]"; then
    echo ""
    echo "[ptk] subject must be lower-case: $SUBJECT"
    echo "      change '${FIRST_CHAR}' to '$(echo "$FIRST_CHAR" | tr '[:upper:]' '[:lower:]')'"
    exit 1
fi

exit 0
